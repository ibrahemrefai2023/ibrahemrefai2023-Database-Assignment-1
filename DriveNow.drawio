" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1038" value="DriveNow - Ibrahem Salah Refai | ID: | Group: 3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="25" y="12" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c1039" value="Part C - Questions, Assumptions and Contradictions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#102a43;" vertex="1" parent="1"><mxGeometry x="25" y="38" width="1700" height="42" as="geometry"/></mxCell><mxCell id="c1040" value="All assumptions have an SRS section reference and are reflected in the ERD/schema instead of being silently invented." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="27" y="80" width="2900" height="28" as="geometry"/></mxCell><mxCell id="c1041" value="Questions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#102a43;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="25" y="135" width="1030" height="36" as="geometry"/></mxCell><mxCell id="c1042" value="&lt;b&gt;7.1&lt;/b&gt; Is a temporary regional director always stored as an Employee before managing a branch?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="172" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1043" value="&lt;b&gt;7.3&lt;/b&gt; Does a luxury vehicle’s own price need the same effective-date history as category pricing?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="407" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1044" value="&lt;b&gt;7.5&lt;/b&gt; Can a GPS device move between vehicles, and must every installation be retained?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="642" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1045" value="&lt;b&gt;7.8&lt;/b&gt; Can overlapping corporate contracts exist; which one governs a rental?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="877" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1046" value="&lt;b&gt;7.9&lt;/b&gt; Does MaxUses include cancelled/no-show reservations?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="1112" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1047" value="&lt;b&gt;7.12&lt;/b&gt; Must additional drivers have the same validation data as authorized drivers?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="1347" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1048" value="&lt;b&gt;7.16&lt;/b&gt; Which rentals belong to one monthly corporate invoice?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="1582" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1049" value="Assumptions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#102a43;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1105" y="135" width="1030" height="36" as="geometry"/></mxCell><mxCell id="c1050" value="&lt;b&gt;7.1&lt;/b&gt; A temporary manager is an Employee. BRANCH stores the current manager and BRANCH_MANAGER_HISTORY appends each assignment." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1105" y="172" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1051" value="&lt;b&gt;7.3&lt;/b&gt; Vehicle-specific rates use effective From/To dates and never overlap for the same vehicle." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1105" y="407" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1052" value="&lt;b&gt;7.3, 7.6&lt;/b&gt; VEHICLE.CurrentBranch stores latest location and is updated atomically with accepted transfer history." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1105" y="642" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1053" value="&lt;b&gt;7.5&lt;/b&gt; Phase 1 stores only the current GPS installation; GPS reassignment history is not retained." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1105" y="877" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1054" value="&lt;b&gt;7.8&lt;/b&gt; The active contract at pickup governs pricing; the applied base rate is captured in Rental.DailyRateSnapshot." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1105" y="1112" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1055" value="&lt;b&gt;7.9&lt;/b&gt; MaxUses is derived from confirmed/completed reservations, not maintained as a mutable counter." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1105" y="1347" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1056" value="&lt;b&gt;7.16&lt;/b&gt; An invoice lists many rentals; a rental may appear once, so CORPORATE_INVOICE_RENTAL is required." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1105" y="1582" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1057" value="Contradictions" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#102a43;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2185" y="135" width="1030" height="36" as="geometry"/></mxCell><mxCell id="c1058" value="&lt;b&gt;No direct semantic contradiction identified.&lt;/b&gt; The following scope boundaries need a design decision but do not disagree:" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2185" y="172" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1059" value="&lt;b&gt;7.1 / 10&lt;/b&gt; Salary is stored as employee data, while payroll calculation is expressly out of scope." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2185" y="407" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1060" value="&lt;b&gt;7.5 / 10&lt;/b&gt; GPS device registration is in scope, while real-time GPS tracking is out of scope." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2185" y="642" width="1030" height="225" as="geometry"/></mxCell><mxCell id="c1061" value="&lt;b&gt;7.12 / 7.16&lt;/b&gt; Card/bank payment records are in scope, while online payment-gateway integration is out of scope." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2185" y="877" width="1030" height="225" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1112" name="4-Business-Rules"><mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="2500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1062" value="DriveNow - Ibrahem Salah Refai | ID: | Group: 3" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="25" y="12" width="1000" height="20" as="geometry"/></mxCell><mxCell id="c1063" value="Part D - Business Rules Beyond Constraints" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#102a43;" vertex="1" parent="1"><mxGeometry x="25" y="38" width="1700" height="42" as="geometry"/></mxCell><mxCell id="c1064" value="Each rule needs cross-row, cross-table or temporal validation, so PK/FK/NN/UQ/CHECK/DEFAULT alone is insufficient." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="27" y="80" width="2900" height="28" as="geometry"/></mxCell><mxCell id="c1065" value="#" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#102a43;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="25" y="140" width="65" height="40" as="geometry"/></mxCell><mxCell id="c1066" value="SRS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#102a43;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="140" width="170" height="40" as="geometry"/></mxCell><mxCell id="c1067" value="Business rule" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#102a43;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="260" y="140" width="750" height="40" as="geometry"/></mxCell><mxCell id="c1068" value="Why constraints are not enough" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#102a43;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="1250" height="40" as="geometry"/></mxCell><mxCell id="c1069" value="How to enforce it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#102a43;strokeColor=#102a43;fontColor=#ffffff;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2260" y="140" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c1070" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="180" width="65" height="350" as="geometry"/></mxCell><mxCell id="c1071" value="7.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="170" height="350" as="geometry"/></mxCell><mxCell id="c1072" value="Every branch has exactly one current manager; one employee cannot manage two branches at the same time; dated manager history must remain valid." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="260" y="180" width="750" height="350" as="geometry"/></mxCell><mxCell id="c1073" value="It compares current and historic rows plus overlapping time intervals. A row CHECK cannot query other Branch or history rows." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="180" width="1250" height="350" as="geometry"/></mxCell><mxCell id="c1074" value="Use a manager-assignment stored procedure: lock branch/employee records, reject overlapping manager intervals, close prior history row, insert the new one in one transaction." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2260" y="180" width="1500" height="350" as="geometry"/></mxCell><mxCell id="c1075" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="535" width="65" height="350" as="geometry"/></mxCell><mxCell id="c1076" value="7.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="535" width="170" height="350" as="geometry"/></mxCell><mxCell id="c1077" value="Price-effective periods may not overlap for the same category or special-price vehicle; old rates must never be overwritten/deleted." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="260" y="535" width="750" height="350" as="geometry"/></mxCell><mxCell id="c1078" value="Temporal overlap and append-only behavior concern multiple rows. UNIQUE(CategoryID, EffectiveFrom) does not prevent an intersecting period." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="535" width="1250" height="350" as="geometry"/></mxCell><mxCell id="c1079" value="Use a price-management procedure or trigger to reject overlaps and deny UPDATE/DELETE; only INSERT a new valid period." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2260" y="535" width="1500" height="350" as="geometry"/></mxCell><mxCell id="c1080" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="890" width="65" height="350" as="geometry"/></mxCell><mxCell id="c1081" value="7.6 / 8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="890" width="170" height="350" as="geometry"/></mxCell><mxCell id="c1082" value="A transfer cannot send a vehicle to its current branch. Accepting it must add history and change CurrentBranch together." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="260" y="890" width="750" height="350" as="geometry"/></mxCell><mxCell id="c1083" value="The comparison needs the new transfer plus the current Vehicle row, and requires coordinated multi-table state changes." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="890" width="1250" height="350" as="geometry"/></mxCell><mxCell id="c1084" value="Use a transaction/stored procedure to lock VEHICLE, validate ToBranchID, insert VEHICLE_TRANSFER and update CurrentBranchID." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2260" y="890" width="1500" height="350" as="geometry"/></mxCell><mxCell id="c1085" value="4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="1245" width="65" height="350" as="geometry"/></mxCell><mxCell id="c1086" value="7.7 / 7.11" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="1245" width="170" height="350" as="geometry"/></mxCell><mxCell id="c1087" value="A blacklisted customer cannot create or confirm a reservation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="260" y="1245" width="750" height="350" as="geometry"/></mxCell><mxCell id="c1088" value="Reservation constraints cannot read the current blacklisted status in the separate Customer row at write time." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="1245" width="1250" height="350" as="geometry"/></mxCell><mxCell id="c1089" value="Use a BEFORE INSERT/UPDATE trigger or reservation service to reject when CUSTOMER.IsBlacklisted is true." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2260" y="1245" width="1500" height="350" as="geometry"/></mxCell><mxCell id="c1090" value="5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="1600" width="65" height="350" as="geometry"/></mxCell><mxCell id="c1091" value="7.12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="1600" width="170" height="350" as="geometry"/></mxCell><mxCell id="c1092" value="A rental may have only one direct extension, although the extension may itself be extended." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="260" y="1600" width="750" height="350" as="geometry"/></mxCell><mxCell id="c1093" value="The rule counts other rentals that already reference the same PreviousRentalID; it is cross-row chain logic." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="1600" width="1250" height="350" as="geometry"/></mxCell><mxCell id="c1094" value="Keep PreviousRentalID UNIQUE and use a trigger/procedure to reject an insert if the proposed predecessor already has a direct child." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2260" y="1600" width="1500" height="350" as="geometry"/></mxCell><mxCell id="c1095" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="25" y="1955" width="65" height="350" as="geometry"/></mxCell><mxCell id="c1096" value="7.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="90" y="1955" width="170" height="350" as="geometry"/></mxCell><mxCell id="c1097" value="An employee cannot be both RentalAgent and Mechanic." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="260" y="1955" width="750" height="350" as="geometry"/></mxCell><mxCell id="c1098" value="The two subtype memberships live in different tables. PK/FK only confirm the employee exists." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="1010" y="1955" width="1250" height="350" as="geometry"/></mxCell><mxCell id="c1099" value="Use reciprocal subtype triggers or an EmployeeRole service that checks the opposite subtype before insert/update." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="2260" y="1955" width="1500" height="350" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
